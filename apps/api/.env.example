PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Must NOT be the `postgres` superuser or a table owner — Postgres RLS is
# bypassed entirely for those roles regardless of policy. Locally this is the
# `app_service` role created by supabase/migrations/*_create_app_service_role.sql
# (postgresql://app_service:app_service_password@127.0.0.1:54322/postgres).
# For a cloud project, create an equivalent non-superuser role there.
DATABASE_URL=
