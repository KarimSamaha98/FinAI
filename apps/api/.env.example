PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Must NOT be the `postgres` superuser or a table owner — Postgres RLS is
# bypassed entirely for those roles regardless of policy. Locally this is the
# `app_service` role created by supabase/migrations/*_create_app_service_role.sql
# (postgresql://app_service:app_service_password@127.0.0.1:54322/postgres).
# For a cloud project, create an equivalent non-superuser role there.
DATABASE_URL=
# Demo seeder (pnpm seed:demo) — optional; defaults are demo@finai.test /
# demo-password-123. Only ever run it against a backend you control.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# FX (automatic rates from Frankfurter — https://frankfurter.dev). Optional;
# the defaults are shown. Rates are cached in memory, so the API must run as a
# long-lived process. FX_FLOOR_DATE bounds the history fetched on first use of a
# currency — kept at/after 2021 because the hosted API throttles ranges starting
# before 2021 to 10 req/min (a self-host has no limit). FRANKFURTER_API_URL
# overrides the provider base (e.g. a self-host). FRANKFURTER_API_TIMEOUT_MS must
# cover the cold full-history fetch (can exceed 20s); raise it on slow links.
# FRANKFURTER_API_URL=https://api.frankfurter.dev/v2
# FX_FLOOR_DATE=2021-01-01
# FRANKFURTER_API_TIMEOUT_MS=30000
